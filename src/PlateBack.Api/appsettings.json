{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "plateback-api",
    "Audience": "plateback-web",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Cors": {
    "Origins": [ "http://localhost:5173" ]
  },
  "BusinessRules": {
    "MaxPerListing": 2,
    "MaxActiveReservations": 3,
    "MaxActiveReservationsLowReliability": 1,
    "LowReliabilityBelow": 60,
    "CollectBonus": 2,
    "LateCancelPenalty": 5,
    "NoShowPenalty": 20,
    "ListingQuantityMax": 200,
    "PickupWindowMin": "00:15:00",
    "PickupWindowMax": "12:00:00",
    "SearchRadiusDefaultKm": 5,
    "SearchRadiusMaxKm": 25
  },
  "Uploads": {
    "Path": "uploads",
    "RequestPath": "/uploads"
  },
  "RateLimits": {
    "AuthPerMinute": 20,
    "PickupCodesPerMinute": 30
  },
  "Jobs": {
    "Enabled": true,
    "ExpiryIntervalSeconds": 60,
    "OutboxIntervalSeconds": 10
  }
}
